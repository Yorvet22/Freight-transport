# Copy to backend/.env and adjust. All values below are safe placeholders.

# HTTP port
PORT=3000

# "production" enables strict checks (SESSION_SECRET required, AUTH_DISABLED forbidden, db:reset refused)
NODE_ENV=development

# MySQL 8 connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
# Development database (created by `npm run db:setup`)
DB_NAME=freightflow
# Test database used by Jest; must end in _test (created and migrated automatically by the test run)
DB_NAME_TEST=freightflow_test

# Secret used to sign session tokens. Required when NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty outside production, a random secret is generated at startup (sessions end on restart).
SESSION_SECRET=replace-with-a-long-random-string

# Allowed cross-origin frontend (e.g. http://localhost:5173). Leave empty for same-origin only.
CORS_ORIGIN=

# Local debugging only: AUTH_DISABLED=true makes every request act as an admin. Never in production.
# AUTH_DISABLED=false

# Set when running behind a reverse proxy (e.g. 1 or "loopback") so rate limiting sees the real client IP
# TRUST_PROXY=1
